# Firebase Web SDK config — copy this file to `.env` and fill in your own project's values.
# These come from Firebase Console → Project Settings → General → "Your apps" → SDK setup and config.
# Note: Firebase web API keys are not secret (access is enforced by Firestore Security Rules, not by
# hiding this key) but each deployment still needs its own project's values here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
